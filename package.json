{
  "name": "dsh-output-setting",
  "version": "1.0.0",
  "description": "DSH output settings: auto-expand reasoning/tool nodes, code block font size and line height, and model output language (auto / Chinese / English)",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js"
  },
  "files": [
    "host.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "assets"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "cordis-plugin",
    "plugin",
    "output",
    "settings",
    "reasoning",
    "code-block"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yijiezhong/dsh-output-setting.git"
  },
  "homepage": "https://github.com/yijiezhong/dsh-output-setting#readme",
  "bugs": {
    "url": "https://github.com/yijiezhong/dsh-output-setting/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
